{
  "checkpoint": {
    "resume_from": null,
    "save_every": 1000
  },
  "data": {
    "device": "mps",
    "seed": 0,
    "train_data": "artifacts/lm_data/tinystories_train_10k.npy",
    "valid_data": "artifacts/lm_data/tinystories_valid_10k.npy"
  },
  "logging": {
    "eval_every": 500,
    "eval_iters": 20,
    "log_every": 50,
    "out_dir": "artifacts/lm_experiments",
    "run_name": "tinystories_smoke_mps",
    "sample_every": 500,
    "sample_max_new_tokens": 80,
    "sample_prompt": "Once upon a time",
    "sample_temperature": 0.8,
    "sample_top_p": 0.9,
    "tokenizer": "artifacts/tokenizer_experiments/training/tokenizers_chunked_mp8/tinystories_train_10k"
  },
  "model": {
    "context_length": 256,
    "d_ff": 1344,
    "d_model": 512,
    "num_heads": 8,
    "num_layers": 4,
    "rope_theta": 10000.0,
    "vocab_size": 10000
  },
  "optimizer": {
    "batch_size": 32,
    "betas": [
      0.9,
      0.95
    ],
    "cosine_cycle_iters": 5000,
    "eps": 1e-08,
    "grad_clip": 1.0,
    "max_iters": 5000,
    "max_lr": 0.0003,
    "min_lr": 3e-05,
    "warmup_iters": 500,
    "weight_decay": 0.1
  }
}
