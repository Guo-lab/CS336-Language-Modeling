{
  "checkpoint": {
    "resume_from": null,
    "save_every": 1000
  },
  "data": {
    "device": "cpu",
    "seed": 0,
    "train_data": "data/train.npy",
    "valid_data": "data/valid.npy"
  },
  "logging": {
    "eval_every": 100,
    "eval_iters": 20,
    "log_every": 10,
    "out_dir": "artifacts/lm_experiments",
    "run_name": "smoke",
    "sample_every": 500
  },
  "model": {
    "context_length": 256,
    "d_ff": 1344,
    "d_model": 512,
    "num_heads": 8,
    "num_layers": 4,
    "rope_theta": 10000.0,
    "vocab_size": 10000
  },
  "optimizer": {
    "batch_size": 32,
    "betas": [
      0.9,
      0.95
    ],
    "cosine_cycle_iters": 10000,
    "eps": 1e-08,
    "grad_clip": 1.0,
    "max_iters": 10000,
    "max_lr": 0.0003,
    "min_lr": 3e-05,
    "warmup_iters": 1000,
    "weight_decay": 0.1
  }
}
